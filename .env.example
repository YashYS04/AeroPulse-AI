# AeroPulse AI Environment Variables Example
# Duplicate this file to .env and provide your Gemini API key if available.
# Note: AeroPulse AI includes a high-fidelity local heuristic fallback engine,
# ensuring 100% operational functionality even without an external API key.

PORT=3001
VITE_API_BASE_URL=http://localhost:3001
GEMINI_API_KEY=your_gemini_api_key_here
NODE_ENV=development
